# Copy to .env to override. Any agent setting (see agent/sre_agent/settings.py) can be set here in UPPER_CASE.

# Host port of the edge-app (inside the Docker network it is always 8080)
EDGE_PORT=18080

# Local model used for diagnosis
OLLAMA_MODEL=qwen2.5:1.5b

# true = log what would be done, change nothing
DRY_RUN=false

# Examples of agent tuning:
# LATENCY_THRESHOLD_S=0.5
# DISK_THRESHOLD=0.85
# APPROVAL_TIMEOUT_S=300
# RESTART_BUDGET=3
# LLM_THREADS=2
